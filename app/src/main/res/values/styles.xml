<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#A8C7FA</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Every dialog in the app: buttons that light up clearly under the remote. -->
    <style name="PhoneTvDialog" parent="android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:buttonBarButtonStyle">@style/PhoneTvDialogButton</item>
        <item name="android:colorAccent">#A8C7FA</item>
    </style>

    <style name="PhoneTvDialogButton" parent="android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/dialog_button</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
